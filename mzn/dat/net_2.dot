strict graph {
    1 [label=a]
    2 [label=b]
    3 [label=c]
    4 [label=d]
    5 [label=e]
    6 [label=f]
    7 [label=g]
    8 [label=h]
    9 [label=i]
    10 [label=j]
    11 [label=k]
    12 [label=l]
    13 [label=m]
    14 [label=n]
    15 [label=o]
    16 [label=p]
    17 [label=q]
    18 [label=r]
    19 [label=s]
    20 [label=t]
    21 [label=u]
    22 [label=v]
    23 [label=w]
    24 [label=x]
    25 [label=y]

    // Vertical connections
    1 -- 6 -- 11 -- 16 -- 21 [order=l]
    2 -- 7 -- 12 -- 17 -- 22 [order=l]
    3 -- 8 -- 13 -- 18 -- 23 [order=l]
    4 -- 9 -- 14 -- 19 -- 24 [order=l]
    5 -- 10 -- 15 -- 20 -- 25 [order=l]

    // Horizontal connections (rank=same)
    rank=same {1 -- 2 -- 3 -- 4 -- 5 [order=c]}
    rank=same {6 -- 7 -- 8 -- 9 -- 10 [order=c]}
    rank=same {11 -- 12 -- 13 -- 14 -- 15 [order=c]}
    rank=same {16 -- 17 -- 18 -- 19 -- 20 [order=c]}
    rank=same {21 -- 22 -- 23 -- 24 -- 25 [order=c]}
}

