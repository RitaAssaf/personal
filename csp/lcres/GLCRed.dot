strict graph {
    0 [type=l, nom="0", label="0",preceds="1,2"];
    1 [type=l, nom="1", label="1",preceds="2"];
    2 [type=l, nom="2", label="2",preceds=""];
    3 [type=l, nom="3", label="3",preceds="0,1,2"];

    4 [type=c, nom="4", label="4",preceds=""];
    5 [type=c, nom="5", label="5",preceds="7,6,4"];
    6 [type=c, nom="6", label="6",preceds="4"];
    7 [type=c, nom="7", label="7",preceds="6,4"];

    0 -- 5;
    0 -- 6;
    0 -- 7;
    1 -- 4;
    1 -- 6;
    2 -- 4;
    2 -- 6;
    3 -- 5;
}
