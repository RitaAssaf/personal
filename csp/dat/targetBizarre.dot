
  strict graph {

        1 [label=a];
        2 [label=b];
        3 [label=c];
        4 [label=d];
        5 [label=e];
        6 [label=f];
        7 [label=g];
        8 [label=h];
        9 [label=i];
        10 [label=j];
        11 [label=k];


        2 -- 3 [angle=90]
        5 -- 6 [angle=90]
        6 -- 8 [angle=90]
        8 -- 9 [angle=90]
        11 -- 10 [angle=90]

       	rank=same {1 -- 3 -- 4 -- 5 [angle=0]}
       	rank=same {6 -- 7 [angle=0]}
       	rank=same {11 -- 8 [angle=0]}
       	rank=same {10 -- 9 [angle=0]}
   }


