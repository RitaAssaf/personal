digraph {
    0 [label=0]
    1 [label=1]
    2 [label=2]
    3 [label=3]

    // Vertical edges with angle=90
    0 -> 2 [angle=90]
    1 -> 3 [angle=90]

    // Horizontal edges with angle=0
    0 -> 1 [angle=0]
    2 -> 3 [angle=0]

    // Rank constraints
    {rank=same; 0; 1;}
    {rank=same; 3; 2;}
}
