

digraph G {
    graph [splines=true, nodesep=0.5, rankdir=TB];
    node [shape=circle, fixedsize=true, width=0.4, fontsize=10];
    0 [label="0"];
    1 [label="1"];
    2 [label="2"];
    3 [label="3"];
    4 [label="4"];

    { rank=same; 0  4  };
   { rank=same; 3 2 };
    0 ->4  [angle=90];
    4 ->1  [angle=0];
    1 ->2  [angle=0];
    3 ->2  [angle=90];
    0 ->3  [angle=0];
}
