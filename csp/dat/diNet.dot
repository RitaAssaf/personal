digraph {
    0 [label=0]
    1 [label=1]
    2 [label=2]
    3 [label=3]
    4 [label=4]
    5 [label=5]
    6 [label=6]
    7 [label=7]
    8 [label=8]

    // Horizontal edges (rank=same) with angle=0
    0 -> 1 [angle=0]
    1 -> 2 [angle=0]
    3 -> 4 [angle=0]
    4 -> 5 [angle=0]
    6 -> 7 [angle=0]
    7 -> 8 [angle=0]

    // Vertical edges with angle=90
    0 -> 3 [angle=90]
    3 -> 6 [angle=90]
    1 -> 4 [angle=90]
    4 -> 7 [angle=90]
    2 -> 5 [angle=90]
    5 -> 8 [angle=90]

    // Rank constraints
    {rank=same; 0; 1; 2;}
    {rank=same; 3; 4; 5;}
    {rank=same; 6; 7; 8;}
}
