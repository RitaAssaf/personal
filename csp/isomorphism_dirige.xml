    <group note="preserving edges">
      <extension>
        <list> %0 %1 </list>
        <supports> (0,1)(0,3)(1,2)(1,4)(2,5)(3,4)(3,6)(4,5)(4,7)(5,8)(6,7)(7,8) </supports>
